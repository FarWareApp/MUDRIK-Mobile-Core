    "memory:core": "node --test test/mobile-core/memory-contract.test.mjs test/mobile-core/memory-conflict-gate.test.mjs test/mobile-core/context-memory-conflict.test.mjs",
    "security:core": "node --test test/mobile-core/security-*.test.mjs test/mobile-core/identity-security-events.test.mjs test/mobile-core/credential-broker.test.mjs"
